import secrets
import string

print("--- Password Generator ---")

while True:
    try:
        length = int(input("Enter password length (min 4): "))
        if length >= 4:
            break
        print("Length must be at least 4.")
    except ValueError:
        print("Invalid number. Try again.")

# Combine character sets
pool = string.ascii_letters + string.digits + string.punctuation

# Guarantee at least one letter, digit, and symbol, then fill the rest
password_chars = [
    secrets.choice(string.ascii_letters),
    secrets.choice(string.digits),
    secrets.choice(string.punctuation)
]
password_chars += [secrets.choice(pool) for _ in range(length - 3)]

# Shuffle using a standard human approach
secrets.SystemRandom().shuffle(password_chars)
password = "".join(password_chars)

print(f"\nYour password: {password}")

# Simplified strength logic (since variety is already guaranteed by the code)
if length < 8:
    print("Status: Weak")
elif length < 12:
    print("Status: Medium")
else:
    print("Status: Strong")
   
